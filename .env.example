# Copy this file to .env.local (same folder) and fill in the values.
# .env.local is git-ignored, so your keys stay on your machine.

# Google Gemini (free tier): create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Gemini Flash model name. If you get a "model not found" error, use the
# Flash model name shown in Google AI Studio (for example gemini-3.5-flash).
GEMINI_MODEL=gemini-3.5-flash

# Tried in order when the main model is overloaded or rate limited (comma-separated; "none" disables).
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-flash-lite-latest

# Notion internal integration token (starts with "ntn_" or "secret_"):
# https://www.notion.so/profile/integrations  ->  New integration  ->  copy the token
NOTION_TOKEN=


# ID of the Notion database that receives tasks: the 32-character ID in the
# database URL, e.g. notion.so/workspace/<THIS_PART>?v=...
# Open the database in Notion -> "..." menu -> Connections -> add your integration.
NOTION_DATABASE_ID=

# Optional. "1" loads the demo meetings whenever the database is empty (used on Render's free
# tier, whose disk is wiped on restart). Leave unset locally.
# SEED_DEMO_ON_EMPTY=1
